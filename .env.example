# Copia questo file in ".env" e inserisci i valori reali.
# NON committare mai il file ".env" (gia' escluso da .gitignore).
#
# Questi valori servono SOLO allo script offline tools/generate-audio.mjs.
# Il gioco nel browser non li legge mai: usa gli mp3 gia' generati.

# --- Modo 1 (consigliato): generazione tramite proxy -------------------
# La chiave ElevenLabs resta dentro il Cloudflare Worker, mai su disco qui.
TTS_PROXY_URL=
TTS_PROXY_TOKEN=

# --- Modo 2: chiamata diretta a ElevenLabs dal tuo computer -----------
# Piu' semplice se generi gli audio da una sola macchina.
ELEVENLABS_API_KEY=inserisci_qui_la_tua_chiave

# --- Le due voci del progetto ----------------------------------------
# Ruoli distinti, non gusto estetico: al bambino deve bastare il timbro
# per capire se quello che sente e' inglese da imparare o italiano da capire.
#
# VOICE_ID_ENGLISH   modello di pronuncia. Dice tutte le parole e le frasi
#                    inglesi del curriculum: e' la voce da imitare.
# VOICE_ID_NARRATOR  voce di Zibo. Dice le battute italiane: accoglienza,
#                    istruzioni, incoraggiamenti.
VOICE_ID_ENGLISH=
VOICE_ID_NARRATOR=

# --- Opzionali --------------------------------------------------------
# ELEVENLABS_MODEL=eleven_multilingual_v2
