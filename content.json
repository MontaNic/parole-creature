  "phases": [
    {
      "id": 1,
      "title_it": "Ascolto e riconoscimento",
      "goal_it": "Collegare suono e immagine senza passare dalla lettura. Le prime strutture entrano come formule intere, ascoltate e riconosciute, non analizzate.",
      "desc_it": "La parola scritta non compare mai. Il bambino sente e indica.",
      "showWrittenWord": false
    },
    {
      "id": 2,
      "title_it": "La parola scritta",
      "goal_it": "Rendere visibile cio' che l'orecchio ha gia' imparato, e usare la forma scritta per far notare quello che l'audio nasconde: la -s del plurale e la differenza fra is e are.",
      "desc_it": "La forma scritta compare accanto a immagine e audio.",
      "showWrittenWord": true
    },
    {
      "id": 3,
      "title_it": "Frasi e mini-dialoghi",
      "goal_it": "Passare dal riconoscere al costruire: mettere insieme una frase di 4-6 parole e reggere un piccolo scambio di domanda e risposta.",
      "desc_it": "Frasi cortissime e mini-dialoghi, sempre con audio.",
      "showWrittenWord": true
    },
    {
      "id": 4,
      "title_it": "Mini-ebook (graded reader)",
      "goal_it": "Rivedere lo stesso lessico fuori dal gioco, in un testo continuo.",
      "desc_it": "Libretti originali da generare e inviare su Kindle. Gestiti dai genitori.",
      "showWrittenWord": true,
      "parentOnly": true
    },
    {
      "id": 5,
      "title_it": "Cartoni e film in inglese",
      "goal_it": "Esporsi a inglese vero, piu' veloce e disordinato di quello del gioco.",
      "desc_it": "Suggerimenti audiovisivi progressivi. Gestiti dai genitori.",
      "showWrittenWord": true,
      "parentOnly": true
    }
  ],

  "structures": [
    {
      "id": "st_what_is_it", "phase": 1, "unit": 1,
      "pattern": "What is it? — A dragon.",
      "focus_it": "Capire la domanda che introduce ogni esercizio e rispondere con il nome.",
      "why_it": "E' la formula che il bambino sentira' centinaia di volte nel gioco: impararla subito come blocco unico rende trasparente tutto il resto."
    },
    {
      "id": "st_a_an", "phase": 1, "unit": 2,
      "pattern": "It's a tooth. / It's an egg.",
      "focus_it": "L'articolo cambia davanti a vocale: a / an.",
      "why_it": "In italiano l'articolo non si comporta cosi'. Va sentito presto e spesso, molto prima di poterlo spiegare."
    },
    {
      "id": "st_adj_noun", "phase": 1, "unit": 3,
      "pattern": "It's a red egg.",
      "focus_it": "In inglese il colore va PRIMA del nome.",
      "why_it": "E' l'errore piu' frequente e piu' duraturo degli italiani ('a dragon red'). Si previene facendolo ascoltare come formula, non correggendolo dopo."
    },
    {
      "id": "st_how_many", "phase": 1, "unit": 4,
      "pattern": "How many? — Three.",
      "focus_it": "Contare da uno a dieci rispondendo a una domanda.",
      "why_it": "I numeri restano isolati se non hanno una domanda che li chiama."
    },
    {
      "id": "st_this_these", "phase": 2, "unit": 5,
      "pattern": "This is a cat. / These are cats.",
      "focus_it": "This / these e la -s del plurale.",
      "why_it": "La -s finale in inglese parlato e' quasi impercettibile per un orecchio italiano: si introduce quando la parola scritta la rende visibile."
    },
    {
      "id": "st_be_sing_plur", "phase": 2, "unit": 6,
      "pattern": "The cat is small. / The cats are small.",
      "focus_it": "is per uno, are per piu' di uno.",
      "why_it": "Prima vera regola grammaticale del corso: arriva solo dopo che singolare e plurale sono gia' familiari all'occhio."
    },
    {
      "id": "st_i_have_see", "phase": 3, "unit": 7,
      "pattern": "I have a sword. / I can see a monster.",
      "focus_it": "Frasi con soggetto 'io': dire cosa si ha e cosa si vede.",
      "why_it": "Il primo passo dal riconoscere al dire qualcosa di proprio."
    },
    {
      "id": "st_questions", "phase": 3, "unit": 8,
      "pattern": "Is it red? — Yes, it is. / What is your name?",
      "focus_it": "Fare una domanda e dare una risposta breve.",
      "why_it": "Chiude il cerchio: il bambino usa la stessa struttura con cui il gioco lo interroga dall'unita' 1."
    }
  ],

